@article{chen2023spatial,
  author    = {Chen, Wei and Smith, Sarah and Tanaka, Yuki},
  title     = {Spatial transcriptomics reveals tumor microenvironment heterogeneity in colorectal cancer},
  journal   = {Nature Medicine},
  year      = {2023},
  volume    = {29},
  number    = {4},
  pages     = {812--825},
  doi       = {10.1038/s41591-023-02345-6},
  abstract  = {Spatial transcriptomics enables the mapping of gene expression within intact tissue sections. We applied spatial transcriptomics to 45 colorectal cancer specimens and identified distinct tumor microenvironment niches associated with patient outcomes. Our analysis revealed spatially restricted immune cell populations and their interactions with cancer cells.}
}

@inproceedings{patel2022machine,
  author    = {Patel, Priya and Mueller, Anna and Garcia, Maria},
  title     = {Machine learning approaches for biomarker discovery in spatially resolved transcriptomic data},
  booktitle = {Proceedings of the International Conference on Bioinformatics},
  year      = {2022},
  pages     = {134--142},
  doi       = {10.1145/3535508.3545539},
  abstract  = {We developed a graph neural network framework for identifying spatially variable genes and biomarkers from spatial transcriptomics data. Applied to colorectal cancer tissue microarrays, our method identified 23 novel biomarker candidates with improved predictive accuracy compared to conventional differential expression analysis.}
}

@book{zhang2024atlas,
  author    = {Zhang, Wei and Johnson, James and Andersson, Lars},
  title     = {Atlas of Spatial Omics in Colorectal Cancer},
  publisher = {Springer Nature},
  year      = {2024},
  doi       = {10.1007/978-3-031-45678-9},
  abstract  = {This comprehensive atlas provides a detailed reference for spatial omics technologies applied to colorectal cancer research. Covering spatial transcriptomics, spatial proteomics, and spatial metabolomics, the book presents standardized protocols, computational pipelines, and clinical applications for understanding tumor heterogeneity.}
}
